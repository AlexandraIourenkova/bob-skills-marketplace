*PROCESS MARGINS(1,80);
/* BILLSUB: posts an order total to the customer master, keyed VSAM.         */
/* Original test fixture for zos-app-insight, Apache-2.0. Code in column 1.  */
BILLSUB: PROCEDURE(ORDER_ID, ORDER_TOTAL);
DCL ORDER_ID    CHAR(10);
DCL ORDER_TOTAL FIXED DEC(11,2);
DCL CUSTMAS FILE RECORD UPDATE DIRECT KEYED ENV(VSAM);
DCL 1 CUST_REC, 2 CR_KEY CHAR(8), 2 CR_BAL FIXED DEC(11,2), 2 CR_LIMIT BIN(31);
DCL KEY_MISS BIT(1) INIT('0'B);
ON KEY(CUSTMAS) KEY_MISS = '1'B;
OPEN FILE(CUSTMAS);
READ FILE(CUSTMAS) INTO(CUST_REC) KEY(SUBSTR(ORDER_ID, 1, 8));
IF ^KEY_MISS THEN DO;
   CR_BAL = CR_BAL + ORDER_TOTAL;
   REWRITE FILE(CUSTMAS) FROM(CUST_REC) KEY(CR_KEY);
END;
CLOSE FILE(CUSTMAS);
END BILLSUB;
