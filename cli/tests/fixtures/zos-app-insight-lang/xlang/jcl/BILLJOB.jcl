//BILLJOB  JOB (ACCT),'BILLING LANGUAGES',CLASS=A
//*  Original test job: one step for each language of the billing run.
//PRICE    EXEC PGM=BILLMAIN
//ORDFILE  DD DSN=BILL.ORDERS.DAILY,DISP=SHR
//BILLDD   DD DSN=BILL.ORDERS.BILLED,DISP=(NEW,CATLG)
//RERATE   EXEC PGM=RECALC
//USAGE    EXEC PGM=BILLRUN
//USAGEIN  DD DSN=BILL.USAGE.DAILY,DISP=SHR
//INVOICE  DD SYSOUT=*
//LOAD     EXEC PGM=IKJEFT01
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  %ORDLOAD 20261021 FULL
  EXEC 'BILL.EXEC(ORDMENU)' 'NIGHT'
  LISTCAT LEVEL(BILL)
/*
//BATCHRX  EXEC PGM=IRXJCL,PARM='ORDLOAD 20261021'
//SYSEXEC  DD DSN=BILL.EXEC,DISP=SHR
//SYSTSPRT DD SYSOUT=*
