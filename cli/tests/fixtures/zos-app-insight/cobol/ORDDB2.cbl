IDENTIFICATION DIVISION.
PROGRAM-ID. ORDDB2.
*> Loads order totals into DB2, one customer at a time.
DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CUST-ID        PIC X(8).
01 WS-TOTAL          PIC S9(9)V99 COMP-3.
01 WS-NAME           PIC X(30).
01 WS-DONE           PIC X VALUE 'N'.
   88 NO-MORE-ROWS   VALUE 'Y'.
   EXEC SQL INCLUDE SQLCA END-EXEC.
   EXEC SQL
       DECLARE CUSTCUR CURSOR FOR
       SELECT CUST_ID, CUST_NAME
         FROM BILLING.CUSTOMER C
        WHERE C.STATUS = 'A'
   END-EXEC.
PROCEDURE DIVISION.
MAIN-PARA.
    EXEC SQL OPEN CUSTCUR END-EXEC
    PERFORM FETCH-ONE UNTIL NO-MORE-ROWS
    EXEC SQL CLOSE CUSTCUR END-EXEC
    GOBACK.
FETCH-ONE.
    EXEC SQL
        FETCH CUSTCUR INTO :WS-CUST-ID, :WS-NAME
    END-EXEC
    IF SQLCODE = 100
       SET NO-MORE-ROWS TO TRUE
    ELSE
       EXEC SQL
           SELECT SUM(AMOUNT) INTO :WS-TOTAL
             FROM BILLING.ORDERS
            WHERE CUST_ID = :WS-CUST-ID
       END-EXEC
       EXEC SQL
           INSERT INTO BILLING.CUST_TOTALS (CUST_ID, TOTAL)
           VALUES (:WS-CUST-ID, :WS-TOTAL)
       END-EXEC
    END-IF.
