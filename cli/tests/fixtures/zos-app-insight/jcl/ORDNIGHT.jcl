//ORDNIGHT JOB (ACCT),'NIGHTLY BILLING',CLASS=A,
//             MSGCLASS=X,NOTIFY=&SYSUID
//*  Nightly order billing. Original sample for the zos-app-insight tests.
//         SET HLQ=BILLING
//         SET ENV='PROD'                  * ENVIRONMENT QUALIFIER
//ORDSORT  PROC SORTIN=&HLQ..ORDERS.RAW
//SORT1    EXEC PGM=SORT
//SORTIN   DD DSN=&SORTIN,DISP=SHR
//SORTOUT  DD DSN=&&SORTED,DISP=(NEW,PASS),
//            SPACE=(CYL,(5,5))
//SYSIN    DD DUMMY
//         PEND
//STEP010  EXEC ORDSORT
//STEP020  EXEC PGM=ORDMAIN,COND=(4,LT),
//             PARM='NIGHTLY,FULL'
//ORDIN    DD DSN=&HLQ..&ENV..ORDERS.DAILY,DISP=SHR
//CUSTMAST DD DSN=&HLQ..&ENV..CUSTOMER.MASTER,
//            DISP=OLD
//RPTOUT   DD SYSOUT=*
//CTLCARD  DD *
RUNDATE=TODAY
REGION=ALL
/*
//STEP030  EXEC PROC=ORDPROC,RPTCLS=B
//STEP040  EXEC PGM=IKJEFT01,DYNAMNBR=20
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN PROGRAM(ORDDB2) PLAN(ORDPLAN)
  END
/*
//
