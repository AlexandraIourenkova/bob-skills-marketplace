{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlexandraIourenkova/bob-skills-marketplace/schemas/index.schema.json",
  "title": "Bob Skills Marketplace search index (index.json)",
  "description": "Generated from vendors.json and every packs/<vendor>/<name>/pack.json by `bob-skills registry build-index`. Read by `bob-skills search`, the catalog page and the find-skills skill. Never edited by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generated",
    "packs"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "generated": {
      "type": "string",
      "format": "date-time"
    },
    "registry": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      }
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "displayName",
          "vendor",
          "vendorDisplayName",
          "vendorStatus",
          "version",
          "description",
          "path",
          "skills",
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "vendorDisplayName": {
            "type": "string"
          },
          "vendorStatus": {
            "type": "string",
            "enum": [
              "active",
              "planned",
              "suspended"
            ]
          },
          "version": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "homepage": {
            "type": "string"
          },
          "minBob": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path": {
            "type": "string",
            "description": "Pack folder relative to the registry root."
          },
          "tag": {
            "type": "string",
            "description": "Git tag of this version: <name>--v<version>."
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "description"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "digest": {
                  "type": "string"
                }
              }
            }
          },
          "mcpServers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "modes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Custom mode slugs shipped by the pack."
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "Digest of the whole pack folder."
          },
          "revokedVersions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "versions": {
            "type": "array",
            "description": "Released versions known from git tags, newest first.",
            "items": {
              "type": "string"
            }
          },
          "scan": {
            "type": "object",
            "description": "Gate results for this version: SkillSpector risk score (0-100, after the pack's .skillspector-baseline.yaml), Cisco skill-scanner maximum severity, verdict (pass, review, block, pending), policy baseline size. Written by scripts/run_scanners.py into .scan.json and merged by build-index.",
            "properties": {
              "riskScore": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "policyFindings": {
                "type": "integer"
              },
              "scannedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "pass",
                  "review",
                  "block",
                  "pending"
                ]
              },
              "skillspectorVersion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "skillspectorSuppressed": {
                "type": "integer"
              },
              "ciscoMaxSeverity": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ciscoVersion": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "baselineFindings": {
            "type": "integer",
            "minimum": 0,
            "description": "Accepted policy-linter findings in .policy-baseline.json."
          },
          "components": {
            "type": "integer",
            "minimum": 0,
            "description": "Checksummed components in pack.json."
          },
          "readme": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "properties": {
              "repo": {
                "type": "string"
              },
              "ref": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          },
          "sources": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "repo": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              }
            }
          },
          "safety": {
            "type": "array",
            "description": "Known risks a user must see before installing: what the pack's skills do that needs care, and what closes it. Shown by `bob-skills show`, by `add`, in the offline catalog and on the website. A pack whose skills write to external systems declares it here.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "warning",
                "covered"
              ],
              "properties": {
                "class": {
                  "type": "string",
                  "enum": [
                    "writes",
                    "cost",
                    "content",
                    "transport",
                    "data"
                  ],
                  "description": "writes: changes outside the workspace; cost: billable resources; content: outside content can steer actions; transport: TLS or exposure; data: data leaves the machine."
                },
                "warning": {
                  "type": "string",
                  "minLength": 20,
                  "description": "What the skills do, in the user's terms."
                },
                "covered": {
                  "type": "string",
                  "minLength": 20,
                  "description": "What closes it in practice: the rule, the confirmation step, the setting."
                }
              }
            }
          }
        }
      }
    },
    "planned": {
      "type": "array",
      "description": "Planned packs from roadmap.json: not installable, votes are thumbs-up reactions on the request issue.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "displayName",
          "vendor",
          "vendorDisplayName",
          "status",
          "description",
          "source",
          "issue",
          "votes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "vendorDisplayName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "coming-soon",
              "candidate"
            ]
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "blockedBy": {
            "type": "string"
          },
          "issue": {
            "type": "string",
            "format": "uri"
          },
          "votes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "vendors": {
      "type": "array",
      "description": "Vendors from vendors.json with the packs curated from each.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "status",
          "packs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "homepage": {
            "type": "string"
          },
          "github": {
            "type": "object"
          },
          "extraSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "packs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
